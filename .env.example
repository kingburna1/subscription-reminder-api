# Application Environment (local | development | production)
NODE_ENV=local
PORT=6500

# Option 1: Direct Connection URL (recommended for hosted databases like Neon, Supabase, Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Individual Connection Parameters (standard for local databases)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=subscription_app
DB_PASSWORD=your_password_here
DB_DATABASE=subscription_reminder_db

# Database SSL (false for local, true for cloud/online hosted)
DB_SSL=false